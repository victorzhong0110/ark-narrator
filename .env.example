# HuggingFace
HF_TOKEN=hf_your_token_here
HF_REPO_ID=victorzhong0110/ark-narrator-qwen2.5

# OpenAI (for data augmentation)
OPENAI_API_KEY=sk-your_key_here

# Weights & Biases (experiment tracking)
WANDB_API_KEY=your_wandb_key_here
WANDB_PROJECT=ark-narrator

# Inference server
API_HOST=0.0.0.0
API_PORT=8000

# ── 干员对话产品（app/）配置 ──────────────────────────────────
# 部署档位（一键切换整套栈，详见 docs/DEPLOYMENT_TIERS.md）：budget | standard | flagship
# 留空=不套档位，用下面各项的显式值。优先级：显式 env > .env > 档位 > 硬默认。
ARK_PROFILE=

# 后端：mlx（本地真模型）| api（OpenAI 兼容云端）| pool（自注册 Mac 节点池,分布式）| scripted（演示/CI）
ARK_BACKEND=mlx
ARK_MODEL_PATH=mlx-community/Qwen3-8B-4bit
# ARK_ADAPTER_DIR=checkpoints/qwen3_roleplay   # 可选，base 路线不需要
# api 后端（backend=api 时）：MiniMax/DeepSeek/通义等 OpenAI 兼容端点
# ARK_API_BASE_URL=https://api.minimaxi.com/v1
# ARK_API_KEY=
# pool 后端（backend=pool 时）：Mac 节点心跳注册到这个组名；需 ARK_STORE=redis
ARK_NODE_GROUP=models
# 节点地址白名单(host前缀,逗号分隔)防 SSRF；留空=放行私网/主机名但拒云元数据/链路本地
# ARK_NODE_ALLOWLIST=192.168.,10.
# 关思考链：自托管 Qwen 节点(mlx_lm.server/vLLM)设 true，否则 Qwen3 思考会让回复为空；
# 云端通用 OpenAI 端点可能不支持此参数，按需开。pool 后端默认已开。
ARK_DISABLE_THINKING=false

# 生成
ARK_TEMPERATURE=0.7
ARK_MAX_TOKENS=320
ARK_MAX_HISTORY_TURNS=8

# 入口护栏
ARK_MAX_INPUT_CHARS=800
ARK_RATE_LIMIT_PER_MIN=30
ARK_SESSION_RISK_THRESHOLD=5

# RAG
ARK_RAG=true
ARK_RAG_TOP_K=3

# 场景情绪判定：llm（读语义,准,每轮多一次短分类调用）| heuristic（关键词,零成本兜底）
ARK_SCENE_TAGGER=llm

# 状态存储：memory（单机）| sqlite（单机持久）| redis（多 worker 共享，横向扩展）
ARK_STORE=memory
# ARK_STORE_PATH=data/state.sqlite        # sqlite 用
# ARK_REDIS_URL=redis://localhost:6379/0  # redis 用
# 长期记忆：每 N 轮 用户×角色 滚动摘要一次（让角色跨会话记得玩家）；上限字数
ARK_MEMORY_EVERY=6
ARK_MEMORY_MAX_CHARS=600

# 出口护栏 · 云端审核
# provider: mock（无凭证可跑,dev/CI）| http（POST 到你的审核网关）| aliyun | tencent
ARK_CLOUD_AUDIT=false
ARK_CLOUD_AUDIT_PROVIDER=mock
ARK_CLOUD_AUDIT_TIMEOUT=2.0
ARK_CLOUD_AUDIT_RETRIES=1
ARK_CLOUD_AUDIT_CACHE_TTL=300
ARK_CLOUD_AUDIT_FAIL_CLOSED=false
# ARK_CLOUD_AUDIT_ENDPOINT=https://your-gateway/audit   # http provider 用
# ARK_CLOUD_AUDIT_KEY=
# ARK_CLOUD_AUDIT_SECRET=

# 鉴权（P4）：none | apikey(X-API-Key) | jwt(Bearer,验签后取player_id)。留空=按下面key是否设自动判定
ARK_AUTH_MODE=
ARK_API_AUTH_KEY=
# ARK_JWT_SECRET=           # jwt 模式：与游戏鉴权服务共享的 HS256 密钥
ARK_MAX_BODY_BYTES=65536    # 请求体上限，防超大 payload

# 合规：AI 标识
ARK_AI_LABEL=本回复由 AI 生成 · 角色与世界观版权归鹰角网络所有

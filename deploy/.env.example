# compose-prod 的机密/覆盖项。复制为 deploy/.env（已 gitignore），按需填。
# 真模型（二选一）：
# ARK_BACKEND=api
# ARK_API_BASE_URL=http://your-vllm-or-mac-fleet/v1
# ARK_API_KEY=
# 或 pool（指向自注册的 Mac 机队）：ARK_BACKEND=pool

# Redis HA（--profile ha 时）：走 Sentinel
# ARK_REDIS_SENTINELS=sentinel:26379
# ARK_REDIS_MASTER=mymaster

# 安全 / 合规
# ARK_API_AUTH_KEY=请填强随机串
# ARK_CLOUD_AUDIT_PROVIDER=http
# ARK_CLOUD_AUDIT_ENDPOINT=https://your-gateway/audit
